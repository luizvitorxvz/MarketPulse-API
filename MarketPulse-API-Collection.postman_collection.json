    {
      "name": "4. PATCH /produtos/{id}/estoque — Ajuste de Estoque",
      "item": [
        {
          "name": "Reposição (+10)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/produtos/PROD-302/estoque",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "produtos",
                "PROD-302",
                "estoque"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantidade_adicional\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Estoque somado\", () => { const j = pm.response.json(); pm.expect(j.estoque_atualizado).to.eql(j.estoque_anterior + 10); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Baixa manual (-3)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
