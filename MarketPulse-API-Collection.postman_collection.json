{
  "info": {
    "name": "MarketPulse-API-Collection",
    "description": "Bateria de testes da MarketPulse API (Domínio 3 — Varejo & E-commerce). Execute com o Collection Runner, na ordem, com a API recém-iniciada.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. GET /produtos — Catálogo",
      "item": [
        {
          "name": "Listar todos os produtos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/produtos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "produtos"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Retorna array com produtos\", () => { const j = pm.response.json(); pm.expect(j).to.be.an(\"array\").that.is.not.empty; pm.expect(j[0]).to.have.all.keys(\"id_produto\",\"nome\",\"categoria\",\"preco\",\"estoque_qtd\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Filtrar por categoria PERIFERICOS",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/produtos?categoria=PERIFERICOS",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "produtos"
              ],
              "query": [
                {
                  "key": "categoria",
                  "value": "PERIFERICOS"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Somente PERIFERICOS\", () => pm.response.json().forEach(p => pm.expect(p.categoria).to.eql(\"PERIFERICOS\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Categoria inexistente retorna []",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/produtos?categoria=BRINQUEDOS",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "produtos"
              ],
              "query": [
                {
                  "key": "categoria",
                  "value": "BRINQUEDOS"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Lista vazia\", () => pm.expect(pm.response.json()).to.eql([]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. POST /pedidos — Fechar Pedido",
      "item": [
        {
          "name": "Fechar pedido com sucesso",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pedidos"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": \"CLI-0042\",\n  \"itens\": [\n    {\n      \"produto_id\": \"PROD-101\",\n      \"quantidade\": 2\n    },\n    {\n      \"produto_id\": \"PROD-202\",\n      \"quantidade\": 1\n    }\n  ],\n  \"forma_pagamento\": \"PIX\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set(\"idPedido\", j.id_pedido);",
                  "pm.test(\"Status inicial PENDENTE_PAGAMENTO\", () => pm.expect(j.status).to.eql(\"PENDENTE_PAGAMENTO\"));",
                  "pm.test(\"Valor total calculado\", () => pm.expect(j.valor_total).to.eql(339.7));"
                ]
              }
            }
          ]
        },
        {
          "name": "Erro 404 - produto inexistente",
