                  "  const j = pm.response.json();",
                  "  pm.expect(j.codigo_erro).to.eql(\"PRODUTO_NAO_ENCONTRADO\");",
                  "  pm.expect(j).to.have.all.keys(\"codigo_erro\",\"mensagem\",\"timestamp\");",
                  "});"
                ]
              }
            }
          ]
        },
