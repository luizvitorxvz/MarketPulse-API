    {
      "name": "3. GET /pedidos/{id} — Detalhar Pedido",
      "item": [
        {
          "name": "Detalhar pedido criado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/pedidos/{{idPedido}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pedidos",
                "{{idPedido}}"
              ]
            },
            "description": "Execute antes 'Fechar pedido com sucesso' para preencher {{idPedido}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ID confere\", () => pm.expect(pm.response.json().id_pedido).to.eql(pm.collectionVariables.get(\"idPedido\")));"
                ]
              }
            }
          ]
        },
