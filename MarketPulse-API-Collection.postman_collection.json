            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantidade_adicional\": -3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Estoque subtraído\", () => { const j = pm.response.json(); pm.expect(j.estoque_atualizado).to.eql(j.estoque_anterior - 3); });"
                ]
              }
            }
          ]
        },
